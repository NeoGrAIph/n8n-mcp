# Local-only development example. Do not use these values in platform deployment.
HOST=127.0.0.1
PORT=3000
N8N_WORKFLOWS_ROOT=~/repo/n8n-workflows/dev/workflows
N8N_WORKFLOWS_GIT_ROOT=~/repo/n8n-workflows/dev
N8N_WORKFLOWS_DISPLAY_ROOT=~/repo/n8n-workflows/dev/workflows
SYNESTRA_MCP_ENV=dev
SYNESTRA_MCP_WRITE_POLICY=off
SYNESTRA_MCP_AUTH_TOKEN_FILE=~/repo/n8n-mcp/.local/synestra-mcp-token
SYNESTRA_MCP_ALLOW_UNAUTHENTICATED_LOCAL=false
SYNESTRA_MCP_ALLOW_MISSING_INDEX_READONLY=false
SYNESTRA_MCP_EXPECTED_BRANCH=main
SYNESTRA_MCP_MAX_FILE_BYTES=262144
SYNESTRA_MCP_RESOURCE_LIST_LIMIT=200
SYNESTRA_MCP_SETTLE_TIMEOUT_MS=15000
SYNESTRA_MCP_SETTLE_STABLE_READS=2
SYNESTRA_PLATFORM_DISPLAY_ROOT=~/repo/synestra-platform
